# Dependencies
node_modules/

# Env files - never commit secrets. .env.example files are intentionally
# tracked as onboarding templates.
.env
.env.local
.env.*.local

# Next.js
apps/web/.next/
apps/web/out/
apps/web/next-env.d.ts

# Build output
dist/
build/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Editor/OS
.DS_Store
.vscode/*
!.vscode/settings.json
.idea/

# Claude Code - settings.local.json is per-machine permissions/prefs;
# a shared settings.json (if one gets added later) would stay tracked.
.claude/*
!.claude/settings.json

# TypeScript
*.tsbuildinfo

# Test output
coverage/
apps/web/playwright-report/
apps/web/test-results/
test-results/
