# Copy to .env.local and fill in with values from `supabase status`
# (after `npm run supabase:start`, run from the repo root).

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# HMAC key for the short-lived recovery-marker cookie that gates
# /reset-password/confirm to genuine password-recovery sessions.
# REQUIRED in production (generate with: openssl rand -hex 32). Leave unset
# for local dev — the app uses a built-in insecure fallback outside
# production; `npm run test:e2e` supplies its own via playwright.config.ts.
RECOVERY_MARKER_SECRET=
